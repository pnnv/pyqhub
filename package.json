{
  "name": "pyq-hub",
  "version": "0.1.0",
  "description": "Centralized previous year question paper portal — branch, year and subject wise",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "seed:demo": "node --env-file-if-exists=.env server/seed-demo.js",
    "storage:copy-to-r2": "node --env-file-if-exists=.env server/tools/copy-papers-to-r2.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7"
  }
}
