# Copy to .env (or set in your host's dashboard). Everything has a dev default.
PORT=3000
BASE_URL=http://localhost:3000          # used in verification links
JWT_SECRET=change-me-to-a-long-random-string   # required when NODE_ENV=production
ALLOWED_EMAIL_DOMAIN=nitk.edu.in
MAX_UPLOAD_MB=20
# MongoDB, e.g. the connection string from your Atlas cluster (free M0 tier works).
# The database name comes from the path; "pyqhub" if there is none.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pyqhub?retryWrites=true&w=majority
DATA_DIR=./data                         # uploaded PDFs, when no bucket is configured

# First admin account, created on first start
ADMIN_EMAIL=admin@nitk.edu.in
ADMIN_NAME=Site moderator
ADMIN_PASSWORD=admin12345

# Optional: without SMTP, verification links are printed to the server log
# and shown on screen in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PYQ Hub <no-reply@nitk.edu.in>"

# Optional: keep uploaded PDFs in an S3-compatible bucket instead of DATA_DIR/papers.
# Filebase (free 5 GB): endpoint https://s3.filebase.com with region us-east-1
#   (Filebase's newer docs give https://s3.filebase.io with region auto; either works).
# Cloudflare R2: endpoint https://<account id>.r2.cloudflarestorage.com with region auto.
# Copy PDFs already on local disk across once with: npm run storage:copy-to-bucket
S3_BUCKET=
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
